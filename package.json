{
  "name": "quarantine-no3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QUARANTINE No.3 (제3격리병원) — 1인칭 좀비 서바이벌 호러. Vite + Three.js.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tools --quiet",
